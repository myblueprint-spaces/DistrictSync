#!/bin/sh
# Commit-time gates. Checked once per `git commit`, locally, before the commit is
# written; a non-zero exit aborts it. A git failure must never block a commit, so
# resolve the root defensively and let a clean state pass.
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
if command -v python3 >/dev/null 2>&1; then PY=python3; else PY=python; fi

# 1. claugentic-dev-harness architecture-tree gate. `--staged` scopes it to what is
#    being committed.
out=$("$PY" "$root/scripts/claugentic-check_architecture_tree.py" --staged 2>&1)
if [ $? -ne 0 ]; then
    printf '%s\n' "$out"
    exit 1
fi

# 2. No plaintext email address in a tracked file. This repo is PUBLIC and handles
#    student PII, so the cheapest place to stop a pasted district contact is before
#    the commit exists. Whole-index scan (NOT `--staged`): a freshly `git add`ed file
#    is already in the index so a new leak is seen, and re-scanning the rest is
#    sub-second. Mirrored as a CI step, so a `--no-verify` commit is still caught.
out=$("$PY" "$root/scripts/check_no_emails.py" 2>&1)
if [ $? -ne 0 ]; then
    printf '%s\n' "$out"
    exit 1
fi

exit 0
