<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                           revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>DistrictSync</displayName>
  <description>Update settings for DistrictSync.</description>
  <resources>
    <stringTable>
      <string id="DistrictSync">DistrictSync</string>
      <string id="UpdateMode">Automatic updates</string>
      <string id="UpdateMode_Help">Sets how DistrictSync handles new versions on this computer. This setting wins over the setting chosen in DistrictSync, and DistrictSync cannot change it.

Off: DistrictSync makes no update connection at all.

Notify: DistrictSync checks the signed list of versions and says when a newer one is available. It downloads and installs nothing. This is what DistrictSync does when this policy is not configured.

On: DistrictSync installs new signed versions automatically, never while a conversion is running.

If this policy is not configured, DistrictSync uses the setting chosen during its machine setup, or Notify.</string>
      <string id="UpdateMode_Off">Off: no update connection</string>
      <string id="UpdateMode_Notify">Notify: say when a newer version exists (default)</string>
      <string id="UpdateMode_On">On: install signed updates automatically</string>
    </stringTable>
    <presentationTable>
      <presentation id="UpdateMode">
        <dropdownList refId="UpdateModeValue" defaultItem="1">Update mode:</dropdownList>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
