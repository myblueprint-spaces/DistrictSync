<?xml version="1.0" encoding="utf-8"?>
<!-- Plan 0055 U1 (DSYNC-97): DistrictSync's update policy for Group Policy. Copy this file to
     C:\Windows\PolicyDefinitions (or the domain's Central Store) and en-US\DistrictSync.adml beside it.
     The key, value and the three values are pinned to src/update/policy.py by tests/test_update_mode_admx.py. -->
<policyDefinitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <policyNamespaces>
    <target prefix="districtsync" namespace="myBlueprint.Policies.DistrictSync" />
    <using prefix="windows" namespace="Microsoft.Policies.Windows" />
  </policyNamespaces>
  <resources minRequiredRevision="1.0" />
  <categories>
    <category name="DistrictSync" displayName="$(string.DistrictSync)" />
  </categories>
  <policies>
    <policy name="UpdateMode" class="Machine" displayName="$(string.UpdateMode)" explainText="$(string.UpdateMode_Help)"
            presentation="$(presentation.UpdateMode)" key="Software\Policies\myBlueprint\DistrictSync" valueName="UpdateMode">
      <parentCategory ref="DistrictSync" />
      <disabledValue><string>off</string></disabledValue>
      <supportedOn ref="windows:SUPPORTED_Windows_10_0" />
      <elements>
        <enum id="UpdateModeValue" valueName="UpdateMode" required="true">
          <item displayName="$(string.UpdateMode_Off)"><value><string>off</string></value></item>
          <item displayName="$(string.UpdateMode_Notify)"><value><string>notify</string></value></item>
          <item displayName="$(string.UpdateMode_On)"><value><string>on</string></value></item>
        </enum>
      </elements>
    </policy>
  </policies>
</policyDefinitions>
